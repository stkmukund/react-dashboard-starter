# Environment Variables
# Copy this file to .env or .env.local and configure your values.
# NOTE: Only variables prefixed with VITE_ are exposed to the client-side code.
# Never store server-side secrets or private keys in this file.

# Base path for frontend asset/route hosting (e.g. /my-app/ or /)
VITE_BASE_PATH=/

# Base URL for the backend API (use /api to route through Vite dev proxy)
VITE_API_BASE_URL=/api

# Request timeout in milliseconds (default: 15000)
VITE_API_TIMEOUT=15000

# Optional demo credentials (used when ?demo=true in login URL)
VITE_DEMO_EMAIL=admin@gmail.com
VITE_DEMO_PASSWORD=admin@123
